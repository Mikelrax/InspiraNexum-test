# Credenciales del administrador (copiar a .env.local y cambiar los valores)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena
# Clave para firmar la cookie de sesión (mínimo 32 caracteres aleatorios)
# Generar con: openssl rand -base64 48
AUTH_SECRET=
# (Opcional) Dominio público para los enlaces/QR de registro de cursos, p. ej. https://inspira.example.com
APP_URL=

# Almacén de archivos (Cloudflare R2). Crear un bucket y un API token de R2 con permisos de lectura y escritura.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# (Opcional) Archivo donde guardar la base SQLite. Sin esta variable la base vive solo en memoria
# y cursos, estudiantes y asistencias se pierden al reiniciar el servidor. Ej.: DB_PATH=./datos/inspira.sqlite
DB_PATH=
